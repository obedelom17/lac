# Neon (Postgres) : copier la "connection string"
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Mot de passe de l'espace administrateur
ADMIN_PASSWORD=change-moi
# Chaine aleatoire longue pour signer les cookies
SECRET=une-longue-chaine-aleatoire
# Groq (gratuit) : https://console.groq.com/keys
GROQ_API_KEY=gsk_xxx
# Notifications push : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.org
